<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_shopify_auto_sync" model="ir.cron">
            <field name="name">Shopify: Auto Sync</field>
            <field name="model_id" ref="model_shopify_instance"/>
            <field name="state">code</field>
            <field name="code">
instances = model.search([('active', '=', True), ('auto_sync', '=', True)])
for instance in instances:
    instance.action_sync_all()
            </field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- 09:00 PM UTC, adjust timezone as needed based on server settings -->
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).replace(hour=21, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
