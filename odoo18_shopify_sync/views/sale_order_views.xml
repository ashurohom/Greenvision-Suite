<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_shopify" model="ir.ui.view">
        <field name="name">sale.order.form.shopify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="shopify" string="Shopify">
                    <group>
                        <group>
                            <field name="shopify_order_id" readonly="1"/>
                            <field name="shopify_financial_status" readonly="1"/>
                            <field name="shopify_fulfillment_status" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_shopify_sale_order" model="ir.actions.act_window">
        <field name="name">Shopify Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shopify_order_id', '!=', False)]</field>
    </record>

    <menuitem id="menu_shopify_orders" 
              name="Sales Orders" 
              parent="menu_shopify_operations" 
              action="action_shopify_sale_order" 
              sequence="5"/>
</odoo>
