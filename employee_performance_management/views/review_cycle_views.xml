<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_performance_review_cycle_tree" model="ir.ui.view">
        <field name="name">employee.performance.review.cycle.tree</field>
        <field name="model">employee.performance.review.cycle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="cycle_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="action_employee_performance_review_cycle" model="ir.actions.act_window">
        <field name="name">Review Cycles</field>
        <field name="res_model">employee.performance.review.cycle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_performance_review_cycle"
              name="Review Cycles"
              parent="menu_performance_configuration"
              action="action_employee_performance_review_cycle"
              sequence="70"/>
</odoo>
