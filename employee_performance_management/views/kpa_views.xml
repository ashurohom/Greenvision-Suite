<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_performance_kpa_tree" model="ir.ui.view">
        <field name="name">employee.performance.kpa.tree</field>
        <field name="model">employee.performance.kpa</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="kra_id"/>
                <field name="weightage"/>
            </list>
        </field>
    </record>

    <record id="view_employee_performance_kpa_form" model="ir.ui.view">
        <field name="name">employee.performance.kpa.form</field>
        <field name="model">employee.performance.kpa</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Accounts Payable"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="kra_id"/>
                        </group>
                        <group>
                            <field name="weightage"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_performance_kpa" model="ir.actions.act_window">
        <field name="name">Key Performance Areas (KPA)</field>
        <field name="res_model">employee.performance.kpa</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_performance_kpa"
              name="KPAs"
              parent="menu_performance_configuration"
              action="action_employee_performance_kpa"
              sequence="20"/>
</odoo>
