<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_performance" model="ir.ui.view">
        <field name="name">project.task.form.inherit.performance</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Performance Details" name="performance_details">
                    <group>
                        <group>
                            <field name="performance_relevant"/>
                            <field name="performance_task_type" invisible="performance_relevant == False"/>
                            <field name="kra_id" invisible="performance_relevant == False"/>
                            <field name="kpa_id" invisible="performance_relevant == False"/>
                            <field name="kpi_id" invisible="performance_relevant == False"/>
                        </group>
                        <group invisible="performance_relevant == False">
                            <field name="performance_weightage"/>
                            <field name="planned_performance_score"/>
                            <field name="actual_performance_score"/>
                            <field name="manager_rating"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
