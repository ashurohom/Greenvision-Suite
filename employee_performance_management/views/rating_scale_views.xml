<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_performance_rating_scale_tree" model="ir.ui.view">
        <field name="name">employee.performance.rating.scale.tree</field>
        <field name="model">employee.performance.rating.scale</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="min_score"/>
                <field name="max_score"/>
            </list>
        </field>
    </record>

    <record id="action_employee_performance_rating_scale" model="ir.actions.act_window">
        <field name="name">Rating Scales</field>
        <field name="res_model">employee.performance.rating.scale</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_performance_rating_scale"
              name="Rating Scales"
              parent="menu_performance_configuration"
              action="action_employee_performance_rating_scale"
              sequence="50"/>
</odoo>
