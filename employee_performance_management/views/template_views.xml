<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_performance_template_tree" model="ir.ui.view">
        <field name="name">employee.performance.template.tree</field>
        <field name="model">employee.performance.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="job_id"/>
            </list>
        </field>
    </record>

    <record id="view_employee_performance_template_form" model="ir.ui.view">
        <field name="name">employee.performance.template.form</field>
        <field name="model">employee.performance.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="KRAs">
                            <field name="kra_ids"/>
                        </page>
                        <page string="KPAs">
                            <field name="kpa_ids"/>
                        </page>
                        <page string="KPIs">
                            <field name="kpi_ids"/>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_performance_template" model="ir.actions.act_window">
        <field name="name">Performance Templates</field>
        <field name="res_model">employee.performance.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_performance_template"
              name="Templates"
              parent="menu_performance_configuration"
              action="action_employee_performance_template"
              sequence="40"/>
</odoo>
