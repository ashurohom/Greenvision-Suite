<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_form_inherit_performance" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.performance</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='recruitment']" position="after">
                <group string="Performance Management" name="performance_management">
                    <field name="performance_template_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
