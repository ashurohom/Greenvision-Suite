<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_performance_kpi_tree" model="ir.ui.view">
        <field name="name">employee.performance.kpi.tree</field>
        <field name="model">employee.performance.kpi</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="kpa_id"/>
                <field name="measurement_type"/>
                <field name="target_value"/>
                <field name="weightage"/>
            </list>
        </field>
    </record>

    <record id="view_employee_performance_kpi_form" model="ir.ui.view">
        <field name="name">employee.performance.kpi.form</field>
        <field name="model">employee.performance.kpi</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Invoices Processed"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="kpa_id"/>
                            <field name="measurement_type"/>
                            <field name="calculation_method"/>
                        </group>
                        <group>
                            <field name="target_value"/>
                            <field name="minimum_value"/>
                            <field name="maximum_value"/>
                            <field name="weightage"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_performance_kpi" model="ir.actions.act_window">
        <field name="name">Key Performance Indicators (KPI)</field>
        <field name="res_model">employee.performance.kpi</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_performance_kpi"
              name="KPIs"
              parent="menu_performance_configuration"
              action="action_employee_performance_kpi"
              sequence="30"/>
</odoo>
