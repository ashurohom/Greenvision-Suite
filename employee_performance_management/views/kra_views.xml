<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_performance_kra_tree" model="ir.ui.view">
        <field name="name">employee.performance.kra.tree</field>
        <field name="model">employee.performance.kra</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="weightage"/>
            </list>
        </field>
    </record>

    <record id="view_employee_performance_kra_form" model="ir.ui.view">
        <field name="name">employee.performance.kra.form</field>
        <field name="model">employee.performance.kra</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Financial Management"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="weightage"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_performance_kra" model="ir.actions.act_window">
        <field name="name">Key Result Areas (KRA)</field>
        <field name="res_model">employee.performance.kra</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_performance_kra"
              name="KRAs"
              parent="menu_performance_configuration"
              action="action_employee_performance_kra"
              sequence="10"/>
</odoo>
