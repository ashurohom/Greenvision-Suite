<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_tally_auto_sync" model="ir.cron">
            <field name="name">Tally Auto Sync</field>
            <field name="model_id" ref="model_tally_manual_sync"/> <!-- Change model when automated sync is built fully -->
            <field name="state">code</field>
            <field name="code">model.action_sync()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
        <record id="ir_cron_tally_check_connection" model="ir.cron">
            <field name="name">Tally Connection Check</field>
            <field name="model_id" ref="model_tally_configuration"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_connection()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
