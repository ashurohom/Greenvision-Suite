<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Customer Unique ID Sequence (e.g. CUST-00001) -->
        <record id="seq_tally_customer_id" model="ir.sequence">
            <field name="name">Tally Customer ID</field>
            <field name="code">tally.customer.id</field>
            <field name="prefix">CUST-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

