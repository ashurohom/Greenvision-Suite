<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_configuration_form" model="ir.ui.view">
        <field name="name">tally.configuration.form</field>
        <field name="model">tally.configuration</field>
        <field name="arch" type="xml">
            <form string="Tally Configuration">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Tally Server"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="server_url"/>
                            <field name="company_name"/>
                            <field name="connection_timeout"/>
                        </group>
                        <group>
                            <field name="auth_type"/>
                            <field name="username" invisible="auth_type != 'basic'" required="auth_type == 'basic'"/>
                            <field name="password" invisible="auth_type != 'basic'" required="auth_type == 'basic'" password="True"/>
                            <field name="api_token" invisible="auth_type != 'bearer'" required="auth_type == 'bearer'"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="auto_sync" invisible="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="last_connection"/>
                            <field name="connection_status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tally_configuration_tree" model="ir.ui.view">
        <field name="name">tally.configuration.tree</field>
        <field name="model">tally.configuration</field>
        <field name="arch" type="xml">
            <list string="Tally Configuration">
                <field name="name"/>
                <field name="server_url"/>
                <field name="connection_status"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_tally_configuration" model="ir.actions.act_window">
        <field name="name">Configurations</field>
        <field name="res_model">tally.configuration</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tally_configuration_action" 
              name="Tally Configurations" 
              parent="menu_tally_configuration" 
              action="action_tally_configuration" 
              sequence="10"/>
</odoo>
