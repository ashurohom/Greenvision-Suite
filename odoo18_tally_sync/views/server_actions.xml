<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Server action for bulk exporting Invoices / Bills -->
        <record id="action_bulk_export_move_tally" model="ir.actions.server">
            <field name="name">Export to Tally</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    records.action_export_to_tally()
            </field>
        </record>

        <!-- Server action for bulk exporting Contacts (Partners) -->
        <record id="action_bulk_export_partner_tally" model="ir.actions.server">
            <field name="name">Export to Tally</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    records.action_export_to_tally()
            </field>
        </record>

        <!-- Server action for bulk exporting Payments -->
        <record id="action_bulk_export_payment_tally" model="ir.actions.server">
            <field name="name">Export to Tally</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="binding_model_id" ref="account.model_account_payment"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    records.action_export_to_tally()
            </field>
        </record>

        <!-- Server action for bulk exporting Payments from Invoices / Bills -->
        <record id="action_bulk_export_invoice_payments_tally" model="ir.actions.server">
            <field name="name">Export Payment(s) to Tally</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    records.action_export_payments_to_tally()
            </field>
        </record>
    </data>
</odoo>
