<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_tally" model="ir.ui.view">
        <field name="name">account.move.form.inherit.tally</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add button inside the header -->
            <xpath expr="//header" position="inside">
                <button name="action_export_to_tally" type="object" string="Export to Tally" class="oe_highlight" invisible="state != 'posted' or move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund') or sync_status == 'success'"/>
                <button name="action_export_payments_to_tally" type="object" string="Export Payment to Tally" class="btn-secondary" invisible="state != 'posted' or move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund') or payment_state not in ('in_payment', 'paid')"/>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="Tally Integration" invisible="move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')">
                    <group>
                        <group>
                            <field name="tally_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_sync" readonly="1"/>
                            <field name="sync_status" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
