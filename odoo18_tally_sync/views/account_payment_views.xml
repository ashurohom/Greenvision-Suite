<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_tally" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.tally</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_to_tally" string="Export to Tally" type="object" 
                        class="oe_highlight" invisible="state not in ('in_process', 'paid') or payment_type not in ('inbound', 'outbound') or sync_status == 'success'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Tally Integration" name="tally_integration">
                        <group>
                            <group>
                                <field name="tally_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="last_sync" readonly="1"/>
                                <field name="sync_status" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
