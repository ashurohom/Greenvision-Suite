<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tally_manual_sync_form" model="ir.ui.view">
        <field name="name">tally.manual.sync.form</field>
        <field name="model">tally.manual.sync</field>
        <field name="arch" type="xml">
            <form string="Manual Sync">
                <sheet>
                    <div class="alert alert-success" role="alert" invisible="state != 'done'">
                        <field name="result_message" readonly="1"/>
                    </div>
                    <group invisible="state == 'done'">
                        <group>
                            <field name="sync_model"/>
                            <field name="operation"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_sync" type="object" string="Start Sync" class="oe_highlight" invisible="state == 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tally_manual_sync" model="ir.actions.act_window">
        <field name="name">Manual Sync Wizard</field>
        <field name="res_model">tally.manual.sync</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_tally_manual_sync" 
              name="Manual Sync" 
              parent="menu_tally_integration_root" 
              action="action_tally_manual_sync" 
              sequence="20"/>
</odoo>
