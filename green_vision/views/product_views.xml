<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View -->
    <record id="view_product_template_form_inherit_gv" model="ir.ui.view">
        <field name="name">product.template.form.inherit.gv</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="groups">green_vision.group_show_product_reference</attribute>
            </xpath>
        </field>
    </record>

    <!-- Product Template Tree View -->
    <record id="view_product_template_tree_inherit_gv" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.gv</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="groups">green_vision.group_show_product_reference</attribute>
            </xpath>
        </field>
    </record>

    <!-- Product Variant Form View -->
    <record id="view_product_product_form_inherit_gv" model="ir.ui.view">
        <field name="name">product.product.form.inherit.gv</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="groups">green_vision.group_show_product_reference</attribute>
            </xpath>
        </field>
    </record>

    <!-- Product Variant Tree View -->
    <record id="view_product_product_tree_inherit_gv" model="ir.ui.view">
        <field name="name">product.product.tree.inherit.gv</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="groups">green_vision.group_show_product_reference</attribute>
            </xpath>
        </field>
    </record>
</odoo>
